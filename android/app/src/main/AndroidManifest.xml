<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- qurannaba.com links tapped anywhere (a shared recitation, a halaqa invite, a password
                 reset email) open in the app, on that page (MainActivity). Android checks the site's
                 public/.well-known/assetlinks.json to trust this. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="qurannaba.com" />
                <data android:path="/" />
                <data android:pathPrefix="/qari" />
                <data android:pathPrefix="/h/" />
                <data android:pathPrefix="/halaqa" />
                <data android:pathPrefix="/read" />
                <data android:pathPrefix="/listen" />
                <data android:pathPrefix="/prayer" />
                <data android:pathPrefix="/reset-password" />
            </intent-filter>
        </activity>

        <!-- Notifications sent through Firebase: the Naba mark in the status bar, in gold. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_naba" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/naba_gold" />

        <!-- The adhan with the app closed (Adhan.java): prayer-time alarms, Stop, and setting them again
             after a restart, an update, or "Alarms & reminders" being allowed. -->
        <receiver android:name=".AdhanReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Prayer times and the qibla: the phone's location, asked for the first time the site needs it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Recording a recitation in Qari, and voice search. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Saving a Qari video or a verse picture to the gallery: only Android 9 and older ask for this. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- The light tap felt when turning a page. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The adhan on the minute with the app closed ("Alarms & reminders"; Android 14+ asks the person,
         from the Prayer screen), and its alarms set again after the phone restarts. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Voice search uses the phone's speech recognition; Android 11+ only lets the app see it when asked for here. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Added by libraries but never used: Google sign-in here never asks for a fingerprint. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- None of these is needed to install the app: phones without them still get it from the Play Store. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>
