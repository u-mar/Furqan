generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  username    String    @unique
  name        String
  /// `scrypt$<salt>$<hash>`. Older rows hold a bare SHA-256 hex digest and
  /// are upgraded the next time that PIN is entered correctly.
  pinHash     String
  /// Wrong PINs in a row. A 4-digit PIN has only 10,000 values, so without
  /// a limit any account falls to a script in minutes.
  failedPins  Int?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  key              String   @unique
  dailyVerseKey    String
  dailyVerseSurah  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FeedbackMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  userName  String
  message   String
  contact   String
  createdAt DateTime @default(now())
}

model UserUsage {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique
  userName      String
  userKind      String    @default("guest")
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastOfflineAt DateTime?
  totalVisits   Int       @default(0)
  lastPath      String    @default("/")
  pageViews     Json
  updatedAt     DateTime  @updatedAt
}

/// A published recitation. The audio itself lives in GridFS; `audioId` is the
/// file handle, so documents stay small and streamable.
model Recitation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  userName    String
  userUsername String
  /// GridFS file id for the audio.
  audioId     String
  mimeType    String
  durationSec Int
  sizeBytes   Int
  /// Whatever the reciter called this recording. Optional because the first
  /// recordings were saved with a surah and ayah range instead.
  title       String?
  /// Which room the recitation is played back in — see lib/audio-space. The
  /// tail is applied on playback rather than baked in, so it stays editable.
  space       String?
  /// Lower-case, no leading '#'. Searchable and tappable in the feed.
  hashtags    String[]
  /// Private recordings are visible only to the reciter. Optional so the
  /// recordings made before this existed still read back as public.
  isPrivate   Boolean?
  /// The sheikh whose style this imitates — an id from lib/sheikhs. Absent
  /// when the reciter did not switch Imitate on.
  imitating   String?
  /// Loudness across the recording, 0–100, measured on the phone when it was
  /// published. Draws the waveform without downloading the audio.
  peaks       Int[]
  caption     String   @default("")
  likeCount   Int      @default(0)
  playCount   Int      @default(0)
  /// Hidden by an admin after a report.
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userUsername])
  @@index([likeCount])
  @@index([imitating])
}

/// One qari following another. By username on both sides, because accounts
/// can be local-only (`local_<username>` ids) as well as database-backed.
model QariFollow {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId        String
  followerUsername  String
  followingUsername String
  createdAt         DateTime @default(now())

  @@index([followerId])
  @@index([followingUsername])
}

/// Profile picture for a qari. Keyed by username because accounts can be
/// local-only (`local_<username>` ids) as well as database-backed.
model QariAvatar {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  imageId   String
  mimeType  String
  updatedAt DateTime @updatedAt
}

model RecitationLike {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recitationId String
  userId       String
  createdAt    DateTime @default(now())

  @@unique([recitationId, userId])
  @@index([userId])
}

model RecitationReport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recitationId String
  userId       String
  reason       String
  createdAt    DateTime @default(now())

  @@index([recitationId])
}

model PopupMessage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  body         String
  targetUserId String
  createdAt    DateTime @default(now())
  dismissedBy  String[]
}
