generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  username    String    @unique
  name        String
  /// `scrypt$<salt>$<hash>`. Older rows hold a bare SHA-256 hex digest and
  /// are upgraded the next time that PIN is entered correctly.
  pinHash     String
  /// Wrong PINs in a row. A 4-digit PIN has only 10,000 values, so without
  /// a limit any account falls to a script in minutes.
  failedPins  Int?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  key              String   @unique
  dailyVerseKey    String
  dailyVerseSurah  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FeedbackMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  userName  String
  message   String
  contact   String
  createdAt DateTime @default(now())
}

model UserUsage {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique
  userName      String
  userKind      String    @default("guest")
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastOfflineAt DateTime?
  totalVisits   Int       @default(0)
  lastPath      String    @default("/")
  pageViews     Json
  updatedAt     DateTime  @updatedAt
}

/// A published recitation. The audio itself lives in GridFS; `audioId` is the
/// file handle, so documents stay small and streamable.
model Recitation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  userName    String
  userUsername String
  /// GridFS file id for the audio.
  audioId     String
  mimeType    String
  durationSec Int
  sizeBytes   Int
  /// Whatever the reciter called this recording. Optional because the first
  /// recordings were saved with a surah and ayah range instead.
  title       String?
  /// Which room the recitation is played back in — see lib/audio-space. The
  /// tail is applied on playback rather than baked in, so it stays editable.
  space       String?
  /// Lower-case, no leading '#'. Searchable and tappable in the feed.
  hashtags    String[]
  /// Private recordings are visible only to the reciter. Optional so the
  /// recordings made before this existed still read back as public.
  isPrivate   Boolean?
  /// The sheikh whose style this imitates — an id from lib/sheikhs. Absent
  /// when the reciter did not switch Imitate on.
  imitating   String?
  /// Loudness across the recording, 0–100, measured on the phone when it was
  /// published. Draws the waveform without downloading the audio.
  peaks       Int[]
  caption     String   @default("")
  likeCount   Int      @default(0)
  playCount   Int      @default(0)
  /// Hidden by an admin after a report.
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userUsername])
  @@index([likeCount])
  @@index([imitating])
}

/// One qari following another. By username on both sides, because accounts
/// can be local-only (`local_<username>` ids) as well as database-backed.
model QariFollow {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId        String
  followerUsername  String
  followingUsername String
  createdAt         DateTime @default(now())

  @@index([followerId])
  @@index([followingUsername])
}

/// Profile picture for a qari. Keyed by username because accounts can be
/// local-only (`local_<username>` ids) as well as database-backed.
model QariAvatar {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  imageId   String
  mimeType  String
  updatedAt DateTime @updatedAt
}

model RecitationLike {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recitationId String
  userId       String
  createdAt    DateTime @default(now())

  @@unique([recitationId, userId])
  @@index([userId])
}

model RecitationReport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recitationId String
  userId       String
  reason       String
  createdAt    DateTime @default(now())

  @@index([recitationId])
}

model PopupMessage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  body         String
  targetUserId String
  createdAt    DateTime @default(now())
  dismissedBy  String[]
}

/// A halaqa: people reading the Quran together. Joined with a link and a name,
/// so nobody needs an account.
model Halaqa {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  /// The short code in the invite link. Replaced when the creator makes a new link.
  code           String
  /// First day of the current run, in the creator's calendar (YYYY-MM-DD).
  startDay       String
  /// Last day of a set-time halaqa. Absent when it runs every day with no end.
  endDay         String?
  khatmahEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([code])
}

/// Someone in a halaqa. `memberKey` is a hash of a secret kept on their phone:
/// the secret itself is never stored, and never sent anywhere else.
model HalaqaMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  halaqaId  String
  memberKey String
  name      String
  isCreator Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@index([halaqaId])
  @@index([memberKey])
}

/// A day someone read. Kept per person rather than per halaqa, so reading once
/// counts in every halaqa they are in.
model HalaqaReadDay {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  memberKey String
  /// The reader's own calendar day (YYYY-MM-DD).
  day       String
  /// "app" when reading in Read ticked it; "manual" when they tapped "Yes, I read".
  source    String
  createdAt DateTime @default(now())

  @@index([memberKey, day])
}

/// A khatmah a halaqa reads together, one juz per person or more.
model HalaqaKhatmah {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  halaqaId    String
  /// YYYY-MM-DD, or absent for no deadline.
  finishBy    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([halaqaId])
}

/// A juz someone took in a khatmah.
model HalaqaJuz {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  khatmahId String
  juz       Int
  /// HalaqaMember.id of whoever took it.
  memberId  String
  takenAt   DateTime  @default(now())
  doneAt    DateTime?

  @@index([khatmahId])
}

/// Something that happened to a qari that they should hear about: a like on a
/// recitation, or a new follower. Keyed by the recipient's username, since
/// accounts can be local-only (`local_<username>` ids) as well as database-backed.
/// Repeats are guarded in code (no unique index on this connection): liking,
/// unliking and liking again must not notify twice.
model Notification {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  /// Lower-case username of the person being told.
  recipientUsername String
  /// "like" | "follow"
  type              String
  actorUsername     String
  actorName         String
  /// For a like: which recitation, and its title as it was then.
  recitationId      String?
  recitationTitle   String?
  createdAt         DateTime  @default(now())
  readAt            DateTime?

  @@index([recipientUsername, createdAt])
}

/// A phone that agreed to be notified, for one account. `endpoint` is the push
/// service's address for that phone, and the two keys encrypt what is sent to it.
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([username])
  @@index([endpoint])
}
