# Claude (Anthropic) — picks out the translation of part of an ayah when sharing a few words of it,
# and divides an ayah's translation among the phrases the Qari video view shows it in.
# Create a key at https://console.anthropic.com → API keys. Server only; never exposed to the app.
ANTHROPIC_API_KEY=

# Groq (free tier) — the same jobs with GPT-OSS 120B / Qwen, used when Claude isn't set up.
# Create a key at https://console.groq.com/keys. Server only.
GROQ_API_KEY=

# HuggingFace Inference API token: a last backup model for the same job.
# Get one at: https://huggingface.co/settings/tokens (needs Inference Providers credit)
HF_API_TOKEN=hf_...

# MongoDB connection string for Prisma
# Example: mongodb+srv://user:pass@cluster.mongodb.net/muyassar?retryWrites=true&w=majority
DATABASE_URL=

# Admin dashboard login (/admin) — required for production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: separate signing secret (defaults to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Base URL for Quran Foundation API — no auth needed
QURAN_API_BASE=https://api.quran.com/api/v4

# Optional: LAN / phone testing — comma-separated hosts Next.js may block in dev
# Example: ALLOWED_DEV_ORIGINS=192.168.1.34,10.0.0.5
ALLOWED_DEV_ORIGINS=192.168.1.34

# Somali voice translation MP3s (production CDN). Timings live in public/data/somali-voice/manifest.json
# Example: https://your-bucket.r2.dev/somali-v1  (put chunk-07.mp3 etc. there)
# Leave unset for local dev → MP3s in public/data/somali-voice/audio/
# NEXT_PUBLIC_SOMALI_VOICE_CDN_URL=

# "Continue with Google": the OAuth client id (type "Web application") from Google Cloud →
# APIs & Services → Credentials. Add each site address (http://localhost:3000, https://nabaquran.app)
# under "Authorized JavaScript origins". Only the id is needed; the client secret is not used.
# Left unset, the button still shows but says Google sign-in isn't set up yet.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Password reset emails, sent through Resend (resend.com). EMAIL_FROM must be an address on a
# domain verified in Resend. APP_URL is the public address the reset link points to.
RESEND_API_KEY=
EMAIL_FROM=Naba <no-reply@nabaquran.app>
APP_URL=https://nabaquran.app
